{
  "name": "savve-desktop",
  "productName": "Savve",
  "version": "1.0.0",
  "description": "Savve - Sistem Penitipan Barang (aplikasi desktop + server WiFi lokal)",
  "author": "Savve",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "electron .",
    "dist:win": "node scripts/prepare.mjs --php-windows && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.19"
  },
  "build": {
    "appId": "com.savve.desktop",
    "productName": "Savve",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/laravel",
        "to": "laravel"
      },
      {
        "from": "build/php",
        "to": "php"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Savve",
      "include": "build-resources/installer.nsh"
    }
  }
}
